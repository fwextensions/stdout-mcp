{
  "name": "stdout-mcp",
  "version": "0.1.0",
  "description": "A simple Chrome extension for console-logging *other* Chrome extensions",
  "keywords": [
    "chrome",
    "extension",
    "service worker",
    "manifest v3",
    "console",
    "mcp"
  ],
  "author": "John Dunning",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwextensions/stdout-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fwextensions/stdout-mcp/issues"
  },
  "homepage": "https://github.com/fwextensions/stdout-mcp#readme",
  "type": "module",
  "files": [
    "lib/stdout.js",
    "types",
    "extension",
    "mcp"
  ],
  "exports": {
    ".": {
      "import": "./lib/stdout.js",
      "types": "./types/lib/stdout.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "npm run build && tsc -p mcp",
    "test": "node --test \"test/*.test.js\"",
    "prepublishOnly": "npm run typecheck"
  },
  "bin": {
    "stdout-mcp": "mcp/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^20.19.43",
    "typescript": "^5.5.4"
  }
}
