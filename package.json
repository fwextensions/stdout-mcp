{
  "name": "stdout-mcp",
  "version": "0.1.0",
  "description": "Let coding agents read your Chrome extension's console logs and reload it, without keeping its service worker awake",
  "keywords": [
    "chrome",
    "chrome-extension",
    "extension",
    "service-worker",
    "manifest-v3",
    "console",
    "logging",
    "debugging",
    "mcp",
    "mcp-server",
    "claude-code",
    "codex",
    "coding-agent"
  ],
  "author": "John Dunning",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwextensions/stdout-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fwextensions/stdout-mcp/issues"
  },
  "homepage": "https://github.com/fwextensions/stdout-mcp#readme",
  "type": "module",
  "files": [
    "lib/stdout.js",
    "types",
    "extension",
    "mcp"
  ],
  "exports": {
    ".": {
      "types": "./types/lib/stdout.d.ts",
      "import": "./lib/stdout.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "npm run build && tsc -p mcp",
    "test": "node --test \"test/*.test.js\"",
    "prepublishOnly": "npm run typecheck",
    "release": "dotenv release-it"
  },
  "bin": {
    "stdout-mcp": "mcp/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@release-it/bumper": "^8.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/chrome": "^0.3.6",
    "@types/node": "^20.19.43",
    "dotenv-cli": "^11.1.0",
    "release-it": "^21.1.2",
    "typescript": "^5.5.4"
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "npm run typecheck",
        "npm test"
      ]
    },
    "git": {
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/bumper": {
        "out": {
          "file": "extension/manifest.json",
          "path": "version"
        }
      },
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Added"
            },
            {
              "type": "fix",
              "section": "Fixes"
            },
            {
              "type": "chore",
              "section": "Chores"
            },
            {
              "type": "ci",
              "section": "CI/CD"
            }
          ]
        },
        "infile": "CHANGELOG.md",
        "header": "# Changelog",
        "ignoreRecommendedBump": true
      }
    }
  },
  "overrides": {
    "basic-ftp": "^6.2.6"
  }
}
